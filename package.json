{
  "name": "awgu-stepforward",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "build:web": "bun --cwd apps/web run build",
    "lint:web": "bun --cwd apps/web run lint",
    "typecheck:web": "bun --cwd apps/web run typecheck",
    "dev:mobile": "bun --cwd apps/mobile start",
    "typecheck:mobile": "bun --cwd apps/mobile run typecheck"
  }
}
