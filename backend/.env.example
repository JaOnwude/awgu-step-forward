ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://awgu:awgu@localhost:5432/awgu
CORS_ORIGINS=["http://localhost:3000"]
SESSION_COOKIE_NAME=awgu_session
CSRF_COOKIE_NAME=awgu_csrf
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEV_AUTH_ENABLED=true
# Apply migrations and seed demo data on startup (development only).
DEV_BOOTSTRAP=true
# Messaging adapters: "console" logs messages instead of sending them (week 1).
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# Opportunity assistant (rule-based, no external model). Off by default.
AI_ENABLED=false
# Change in every shared environment; used to hash reporter fingerprints.
REPORT_HASH_SECRET=dev-only-report-secret
