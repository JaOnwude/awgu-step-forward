ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://awgu:awgu@localhost:5432/awgu
CORS_ORIGINS=["http://localhost:3000"]
SESSION_COOKIE_NAME=awgu_session
CSRF_COOKIE_NAME=awgu_csrf
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Demo mode: one-tap sample accounts and on-screen codes when nothing is
# delivered. Set to false for real users.
DEV_AUTH_ENABLED=true
# Apply migrations and seed demo data on startup (development only).
DEV_BOOTSTRAP=true
# Email: "console" only logs. "brevo" or "resend" really send (HTTPS API).
EMAIL_PROVIDER=console
# API key from Brevo (SMTP & API -> API keys) or Resend. Never commit a real key.
EMAIL_API_KEY=
# A sender address you verified with that provider.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Awgu StepForward
# SMS stays console-only (no funded sender yet).
SMS_PROVIDER=console
# Shared secret the hourly GitHub Actions schedule sends to run reminders and
# expiry (POST /api/v1/internal/jobs/run). Empty = endpoint off.
JOBS_TOKEN=
# Opportunity assistant (rule-based, no external model). Off by default.
AI_ENABLED=false
# Change in every shared environment; used to hash reporter fingerprints.
REPORT_HASH_SECRET=dev-only-report-secret
